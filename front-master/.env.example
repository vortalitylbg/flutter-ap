APP_NAME=ResaChev
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=bdd.dombtsig.local
DB_PORT=3306
DB_DATABASE=ap3_demo
DB_USERNAME=ap3_demo-1
DB_PASSWORD=2qdlatbh

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Double authentification par email ---
# true  : un code est envoyé par email à chaque connexion (production)
# false : connexion directe sans code, pratique pour le développement
AUTH_2FA_ENABLED=true

# --- Serveur mail ---
# En développement, MAIL_MAILER=log écrit les emails dans storage/logs au lieu de les envoyer
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.dombtsig.local
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@resachev.fr"
MAIL_FROM_NAME="${APP_NAME}"
