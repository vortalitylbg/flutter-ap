# =============================================================================
# Configuration SQLite pour un test local
# =============================================================================
# Permet de lancer l'application sans serveur MySQL ni serveur SMTP.
# Ne pas utiliser en production : la BDD réelle est MySQL et elle est partagée
# avec les applications C# et Flutter.
#
# Utilisation recommandée, sans toucher à votre .env :
#   touch database/database.sqlite
#   php artisan --env=sqlite migrate:fresh --seed
#   php artisan --env=sqlite serve
#
# L'option --env=sqlite indique à Laravel de lire ce fichier au lieu de .env.
# Votre configuration MySQL reste donc intacte, rien n'est à restaurer ensuite.
#
# Variante : remplacer le .env courant
#   cp .env .env.backup
#   cp .env.sqlite .env
#   touch database/database.sqlite
#   php artisan migrate:fresh --seed && php artisan serve
#
# ATTENTION : migrate:fresh SUPPRIME toutes les tables de la base ciblée.
# Vérifiez bien que DB_CONNECTION vaut sqlite avant de la lancer.
# =============================================================================

APP_NAME=ResaChev

APP_ENV=sqlite

APP_KEY=base64:OsY3yVBYSFLK6MOeFayd3QfuOEVp/llLAqYNFZae5hc=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

# Réduit à 4 tours : le hachage est plus rapide en local (12 en production)
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données ---
# Fichier unique database/database.sqlite, créé par `touch` s'il n'existe pas.
# DB_HOST, DB_PORT, DB_USERNAME et DB_PASSWORD ne servent pas en SQLite.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

# --- Sessions, cache et files d'attente ---
# Pilotes fichier plutôt que `database` : moins d'écritures concurrentes sur le
# fichier SQLite, qui verrouille toute la base à chaque écriture.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# --- Double authentification par email ---
# Désactivée en local : la connexion se fait directement, sans code à saisir.
# Passez à true pour tester le parcours 2FA complet (les emails partent alors
# dans storage/logs/laravel.log, voir MAIL_MAILER ci-dessous).
AUTH_2FA_ENABLED=false

# --- Serveur mail ---
# MAIL_MAILER=log écrit les emails dans storage/logs/laravel.log
# au lieu de les envoyer : aucun serveur SMTP n'est nécessaire.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@resachev.fr"
MAIL_FROM_NAME="${APP_NAME}"
